        type: 3}
    - target: {fileID: 2664805466822587812, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: defaultTexts.Array.data[0]
      value: Quantum Scattering Without Interference
      objectReference: {fileID: 0}
    - target: {fileID: 2664805466822587812, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: defaultTexts.Array.data[1]
      value: "\u5E72\u6E09\u306E\u306A\u3044\u91CF\u5B50\u6563\u4E71"
      objectReference: {fileID: 0}
    - target: {fileID: 2664805466822587812, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: defaultTexts.Array.data[2]
      value: "\u7121\u5E79\u64FE\u91CF\u5B50\u6563\u5C04"
      objectReference: {fileID: 0}
    - target: {fileID: 2664805466822587812, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: defaultTexts.Array.data[3]
      value: "\u65E0\u5E72\u6270\u91CF\u5B50\u6563\u5C04"
      objectReference: {fileID: 0}
    - target: {fileID: 2664805466822587812, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: defaultTexts.Array.data[4]
      value: "\uAC04\uC12D \uC5C6\uB294 \uC591\uC790 \uC0B0\uB780"
      objectReference: {fileID: 0}
    - target: {fileID: 2664805466822587812, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: defaultTexts.Array.data[5]
      value: "Dispers\xE3o Qu\xE2ntica sem Interfer\xEAncia"
      objectReference: {fileID: 0}
    - target: {fileID: 2664805466822587812, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: defaultTexts.Array.data[6]
      value: "Diffusion quantique sans interf\xE9rence"
      objectReference: {fileID: 0}
    - target: {fileID: 5018261539820640780, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: m_Name
      value: ParticleInfo
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageBodies.Array.data[0]
      value: "This panel controls two scattering models:\r\n<indent=5%><b>\u29BF
        A particle beam:</b><br>Individual particles are deflected elastically as
        they pass through apertures in the slit screen, otherwise travelling in straight
        lines. \r\n\r\nTo enable this demonstration to run on a VR headset, the incident
        particle beam is culled to reduce the fraction of particles lost to screen
        collisions.\r\n\r\n<b>\u29BF A particle probability density overlay:</b><br>The
        overlay is generated by a technique similar to ray tracing. The intensity
        at each point on the screen is determined by 'looking back' through the apertures
        at the momentum probability density."
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageBodies.Array.data[1]
      value: "\u3053\u306E\u30D1\u30CD\u30EB\u3067\u306F\u30012\u3064\u306E\u6563\u4E71\u30E2\u30C7\u30EB\u3092\u5236\u5FA1\u3057\u307E\u3059\u3002\r\n<indent=5%><b>\u29BF
        \u7C92\u5B50\u30D3\u30FC\u30E0\uFF1A</b><br>\u500B\u3005\u306E\u7C92\u5B50\u306F\u3001\u30B9\u30EA\u30C3\u30C8\u30B9\u30AF\u30EA\u30FC\u30F3\u306E\u958B\u53E3\u90E8\u3092\u901A\u904E\u3059\u308B\u969B\u306B\u5F3E\u6027\u7684\u306B\u504F\u5411\u3055\u308C\u307E\u3059\u3002\u305D\u308C\u4EE5\u5916\u306E\u5834\u5408\u306F\u76F4\u9032\u3057\u307E\u3059\u3002\r\n\r\n\u3053\u306E\u30C7\u30E2\u30F3\u30B9\u30C8\u30EC\u30FC\u30B7\u30E7\u30F3\u3092VR\u30D8\u30C3\u30C9\u30BB\u30C3\u30C8\u3067\u5B9F\u884C\u3067\u304D\u308B\u3088\u3046\u306B\u3059\u308B\u305F\u3081\u3001\u5165\u5C04\u7C92\u5B50\u30D3\u30FC\u30E0\u306F\u3001\u30B9\u30AF\u30EA\u30FC\u30F3\u3068\u306E\u885D\u7A81\u306B\u3088\u3063\u3066\u5931\u308F\u308C\u308B\u7C92\u5B50\u306E\u5272\u5408\u3092\u6E1B\u3089\u3059\u3088\u3046\u306B\u30AB\u30EA\u30F3\u30B0\u3055\u308C\u307E\u3059\u3002\r\n\r\n<b>\u29BF
        \u7C92\u5B50\u78BA\u7387\u5BC6\u5EA6\u30AA\u30FC\u30D0\u30FC\u30EC\u30A4\uFF1A</b><br>\u30AA\u30FC\u30D0\u30FC\u30EC\u30A4\u306F\u3001\u30EC\u30A4\u30C8\u30EC\u30FC\u30B7\u30F3\u30B0\u306B\u4F3C\u305F\u624B\u6CD5\u3067\u751F\u6210\u3055\u308C\u307E\u3059\u3002\u30B9\u30AF\u30EA\u30FC\u30F3\u4E0A\u306E\u5404\u70B9\u306B\u304A\u3051\u308B\u5F37\u5EA6\u306F\u3001\u904B\u52D5\u91CF\u78BA\u7387\u5BC6\u5EA6\u3067\u958B\u53E3\u90E8\u3092\u901A\u3057\u3066\u300C\u632F\u308A\u8FD4\u308B\u300D\u3053\u3068\u306B\u3088\u3063\u3066\u6C7A\u5B9A\u3055\u308C\u307E\u3059\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageBodies.Array.data[2]
      value: "\u6B64\u9762\u677F\u63A7\u5236\u5169\u7A2E\u6563\u5C04\u6A21\u578B\uFF1A\r\n\r\n<indent=5%><b>\u29BF
        \u7C92\u5B50\u675F\uFF1A</b><br>\u55AE\u4E00\u7C92\u5B50\u5728\u7A7F\u904E\u72F9\u7E2B\u87A2\u5E55\u4E0A\u7684\u5B54\u5F91\u6642\u6703\u767C\u751F\u5F48\u6027\u504F\u8F49\uFF0C\u5426\u5247\u5B83\u5011\u5C07\u6CBF\u76F4\u7DDA\u904B\u52D5\u3002\r\n\r\n\u70BA\u4E86\u4F7F\u6B64\u793A\u7BC4\u80FD\u5920\u5728
        VR \u982D\u6234\u88DD\u7F6E\u4E0A\u904B\u884C\uFF0C\u5165\u5C04\u7C92\u5B50\u675F\u7D93\u904E\u7BE9\u9078\uFF0C\u4EE5\u6E1B\u5C11\u56E0\u78B0\u649E\u87A2\u5E55\u800C\u640D\u5931\u7684\u7C92\u5B50\u6BD4\u4F8B\u3002\r\n\r\n<b>\u29BF
        \u7C92\u5B50\u6A5F\u7387\u5BC6\u5EA6\u758A\u52A0\uFF1A</b><br>\u6B64\u758A\u52A0\u5C64\u63A1\u7528\u985E\u4F3C\u5149\u7DDA\u8FFD\u8E64\u7684\u6280\u8853\u7522\u751F\u3002\u87A2\u5E55\u4E0A\u6BCF\u500B\u9EDE\u7684\u5F37\u5EA6\u662F\u900F\u904E\u300C\u56DE\u6EAF\u300D\u7A7F\u904E\u5B54\u5F91\u7684\u52D5\u91CF\u6A5F\u7387\u5BC6\u5EA6\u4F86\u6C7A\u5B9A\u7684\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageBodies.Array.data[3]
      value: "\u6B64\u9762\u677F\u63A7\u5236\u4E24\u79CD\u6563\u5C04\u6A21\u578B\uFF1A\r\n\r\n<indent=5%><b>\u29BF
        \u7C92\u5B50\u675F\uFF1A</b><br>\u5355\u4E2A\u7C92\u5B50\u5728\u7A7F\u8FC7\u72ED\u7F1D\u5C4F\u5E55\u4E0A\u7684\u5B54\u5F84\u65F6\u4F1A\u53D1\u751F\u5F39\u6027\u504F\u8F6C\uFF0C\u5426\u5219\u5B83\u4EEC\u5C06\u6CBF\u76F4\u7EBF\u8FD0\u52A8\u3002\r\n\r\n\u4E3A\u4E86\u4F7F\u6B64\u6F14\u793A\u80FD\u591F\u5728
        VR \u5934\u663E\u4E0A\u8FD0\u884C\uFF0C\u5165\u5C04\u7C92\u5B50\u675F\u7ECF\u8FC7\u7B5B\u9009\uFF0C\u4EE5\u51CF\u5C11\u56E0\u78B0\u649E\u5C4F\u5E55\u800C\u635F\u5931\u7684\u7C92\u5B50\u6BD4\u4F8B\u3002\r\n\r\n<b>\u29BF
        \u7C92\u5B50\u6982\u7387\u5BC6\u5EA6\u53E0\u52A0\uFF1A</b><br>\u8BE5\u53E0\u52A0\u5C42\u91C7\u7528\u7C7B\u4F3C\u4E8E\u5149\u7EBF\u8FFD\u8E2A\u7684\u6280\u672F\u751F\u6210\u3002\u5C4F\u5E55\u4E0A\u6BCF\u4E2A\u70B9\u7684\u5F3A\u5EA6\u662F\u901A\u8FC7\u201C\u56DE\u6EAF\u201D\u7A7F\u8FC7\u5B54\u5F84\u7684\u52A8\u91CF\u6982\u7387\u5BC6\u5EA6\u6765\u786E\u5B9A\u7684\u3002"
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageBodies.Array.data[4]
      value: "\uC774 \uD328\uB110\uC740 \uB450 \uAC00\uC9C0 \uC0B0\uB780 \uBAA8\uB378\uC744
        \uC81C\uC5B4\uD569\uB2C8\uB2E4.\r\n<b>\u29BF \uC785\uC790 \uBE54:</b><br>\uAC1C\uBCC4
        \uC785\uC790\uB294 \uC2AC\uB9BF \uC2A4\uD06C\uB9B0\uC758 \uAD6C\uBA4D\uC744
        \uD1B5\uACFC\uD560 \uB54C \uD0C4\uC131\uC801\uC73C\uB85C \uD3B8\uD5A5\uB418\uBA70,
        \uADF8\uB807\uC9C0 \uC54A\uC744 \uACBD\uC6B0 \uC9C1\uC120\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.\r\n\r\nVR
        \uD5E4\uB4DC\uC14B\uC5D0\uC11C \uC774 \uB370\uBAA8\uB97C \uC2E4\uD589\uD558\uAE30
        \uC704\uD574 \uC785\uC0AC \uC785\uC790 \uBE54\uC5D0\uC11C \uC2A4\uD06C\uB9B0
        \uCDA9\uB3CC\uB85C \uC190\uC2E4\uB418\uB294 \uC785\uC790\uC758 \uBE44\uC728\uC744
        \uC904\uC774\uAE30 \uC704\uD574 \uC785\uC790 \uC81C\uAC70(culling)\uAC00
        \uC218\uD589\uB429\uB2C8\uB2E4.\r\n\r\n<b>\u29BF \uC785\uC790 \uD655\uB960
        \uBC00\uB3C4 \uC624\uBC84\uB808\uC774:</b><br>\uC774 \uC624\uBC84\uB808\uC774\uB294
        \uB808\uC774 \uD2B8\uB808\uC774\uC2F1\uACFC \uC720\uC0AC\uD55C \uAE30\uC220\uC744
        \uC0AC\uC6A9\uD558\uC5EC \uC0DD\uC131\uB429\uB2C8\uB2E4. \uD654\uBA74\uC758
        \uAC01 \uC9C0\uC810\uC5D0\uC11C\uC758 \uAC15\uB3C4\uB294 \uC6B4\uB3D9\uB7C9
        \uD655\uB960 \uBC00\uB3C4\uC5D0\uC11C \uAD6C\uBA4D\uC744 \uD1B5\uD574 '\uB418\uB3CC\uC544\uBCF4\uB294'
        \uBC29\uC2DD\uC73C\uB85C \uACB0\uC815\uB429\uB2C8\uB2E4."
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageBodies.Array.data[5]
      value: "Este painel controla dois modelos de dispers\xE3o:\r\n<indent=5%><b>\u29BF
        Um feixe de part\xEDculas:</b><br>As part\xEDculas individuais s\xE3o desviadas
        elasticamente ao passarem pelas aberturas na tela com fendas, viajando em
        linha reta.\r\n\r\nPara permitir que esta demonstra\xE7\xE3o seja executada
        em um headset de realidade virtual, o feixe de part\xEDculas incidente \xE9
        filtrado para reduzir a fra\xE7\xE3o de part\xEDculas perdidas devido a colis\xF5es
        com a tela.\r\n\r\n<b>\u29BF Uma sobreposi\xE7\xE3o de densidade de probabilidade
        de part\xEDculas:</b><br>A sobreposi\xE7\xE3o \xE9 gerada por uma t\xE9cnica
        semelhante ao tra\xE7ado de raios. A intensidade em cada ponto da tela \xE9
        determinada \"olhando para tr\xE1s\" atrav\xE9s das aberturas para a densidade
        de probabilidade do momento."
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageBodies.Array.data[6]
      value: "Ce panneau permet de contr\xF4ler deux mod\xE8les de diffusion\_:\r\n\r\n\u29BF
        Faisceau de particules\_: Les particules sont d\xE9vi\xE9es \xE9lastiquement
        lorsqu'elles traversent les ouvertures de l'\xE9cran \xE0 fentes, alors qu'elles
        se d\xE9placent en ligne droite.\r\n\r\nPour que cette d\xE9monstration fonctionne
        sur un casque de r\xE9alit\xE9 virtuelle, le faisceau de particules incident
        est filtr\xE9 afin de r\xE9duire la proportion de particules perdues lors
        des collisions avec l'\xE9cran.\r\n\r\n\u29BF Superposition de densit\xE9
        de probabilit\xE9 des particules\_: Cette superposition est g\xE9n\xE9r\xE9e
        par une technique similaire au lancer de rayons. L'intensit\xE9 en chaque
        point de l'\xE9cran est d\xE9termin\xE9e en \xAB\_revenant\_\xBB sur la densit\xE9
        de probabilit\xE9 d'impulsion \xE0 travers les ouvertures."
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageTitles.Array.data[0]
      value: 'Particle Scattering Models:'
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageTitles.Array.data[1]
      value: "\u7C92\u5B50\u6563\u4E71\u30E2\u30C7\u30EB\uFF1A"
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageTitles.Array.data[2]
      value: "\u7C92\u5B50\u6563\u5C04\u6A21\u578B:"
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageTitles.Array.data[3]
      value: "\u7C92\u5B50\u6563\u5C04\u6A21\u578B:"
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageTitles.Array.data[4]
      value: "\uC785\uC790 \uC0B0\uB780 \uBAA8\uB378:"
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageTitles.Array.data[5]
      value: "Modelos de dispers\xE3o de part\xEDculas:"
      objectReference: {fileID: 0}
    - target: {fileID: 5968076979422627899, guid: f2d982c43c6741946b0d83df7fc8eb2c,
        type: 3}
      propertyPath: pageTitles.Array.data[6]
      value: "Mod\xE8les de diffusion des particules\_:"
      objectReference: {fileID: 0}
